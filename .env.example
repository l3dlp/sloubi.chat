# Sloubi.chat — configuration locale. Copier en `.env` (ignoré par git) et remplir.
# Les vraies variables d'environnement (systemd) passent avant ce fichier.

# Le seul admin : il valide qui peut garder ses lieux par mot de passe.
# À sa première apparition, il devient propriétaire de tous les lieux existants.
ADMIN_EMAIL=

# Codes de connexion par e-mail (comme Daily Jungle). Ordre : SMTP, sinon Brevo,
# sinon le code est écrit dans le journal (journalctl -u sloubi), pratique en dev.
MAIL_SENDER=no-reply@sloubi.chat
BREVO_API_KEY=
# Gmail : validation en deux étapes, puis un mot de passe d'application en SMTP_PASS.
# MAIL_SENDER doit être un alias « Envoyer en tant que » vérifié, sinon SMTP_USER sert d'expéditeur.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Écoute (Caddy est devant)
# PORT=8888
# HOST=127.0.0.1

# Relais TURN des appels (voir deploy/turn.conf)
# TURN_SECRET_FILE=/intelligences/apps/beamcam.live/dev/server/.turn-secret
# TURN_HOST=beamcam.live
# TURN_PORT=3478

# Domaines perso (domains.go) : l'adresse du site, où repartent les domaines inconnus.
# Ses hôtes (et www.) servent le site normal ; tout autre Host est cherché parmi les domaines des lieux.
# SITE_URL=https://sloubi.chat
# SITE_HOSTS=autre-alias.fr
